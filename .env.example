# Public site settings
NEXT_PUBLIC_APP_NAME="Maison Fondjo"
# Canonical site URL (SEO, emails, webhook absolute paths). Set per environment:
# - Local `.env.local` → http://localhost:3000
# - Vercel Production → https://maisonfondjo.com
# Stripe *shopper return* URLs also use the request Origin when present, so
# local checkout returns to localhost even if this is briefly wrong — still set it.
NEXT_PUBLIC_SITE_URL="https://maisonfondjo.com"

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Auth emails (signup confirm + password reset) — sent by SUPABASE, not Resend
# ---------------------------------------------------------------------------
# Resend in this repo is for order/admin notifications only. Account emails use
# Supabase Auth. If you see "email rate limit exceeded", that is Supabase's
# built-in mail limit — not your Resend dashboard quota.
#
# Fix (recommended for production):
# 1. Supabase → Project Settings → Authentication → URL Configuration
#    Site URL: https://maisonfondjo.com   (NOT http://localhost:3000)
#    Redirect URLs (add all):
#      https://maisonfondjo.com/auth/callback
#      https://maisonfondjo.com/auth/callback/**
#      https://www.maisonfondjo.com/auth/callback
#      https://fondjoracine.com/auth/callback   (secondary domain)
#      https://www.fondjoracine.com/auth/callback
#      http://localhost:3000/auth/callback   (local dev only)
# 2. Supabase → Authentication → Email → Custom SMTP (use Resend):
#    Host: smtp.resend.com | Port: 465 | User: resend
#    Password: your RESEND_API_KEY | Sender: RESEND_FROM_EMAIL (verified domain)
# 3. Vercel → Environment variables → NEXT_PUBLIC_SITE_URL=https://maisonfondjo.com
#    Redeploy after changing env or Supabase URL settings.
# 4. Checkout CSRF: orders API only accepts Origins matching SITE_URL (and www),
#    Vercel URLs, or optional ALLOWED_ORIGINS (comma-separated).
#    If live checkout says "Request origin is not allowed", fix SITE_URL to the
#    exact domain shoppers use, then redeploy. Example extras:
#      ALLOWED_ORIGINS="https://www.maisonfondjo.com,https://fondjoracine.com"
# ---------------------------------------------------------------------------
# Identity / sign-in methods — SYSTEM-WIDE (src/lib/identity)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="true"
# Future methods — leave false until dashboard + IdP are ready:
NEXT_PUBLIC_AUTH_APPLE_ENABLED="false"
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED="false"
NEXT_PUBLIC_AUTH_PHONE_ENABLED="false"
#
# Supabase → Authentication → URL Configuration → Redirect URLs must include:
#   http://localhost:3000/auth/callback
#   http://YOUR_LAN_IP:3000/auth/callback
#   https://maisonfondjo.com/auth/callback
# Google Cloud → Credentials → OAuth client → Authorized redirect URIs takes the
# SUPABASE callback, never a site URL — Supabase, not the site, talks to Google:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# YOUR_PROJECT_REF is the subdomain of NEXT_PUBLIC_SUPABASE_URL above.

# Customer accounts / WhatsApp / payments
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Displayed in manual-payment instructions copy (not required for the live MTN/Orange checkout below).
MTN_MOMO_NUMBER=""
ORANGE_MONEY_NUMBER=""

# Mobile Money (MTN MoMo + Orange Money) via Fapshi — required for live checkout
# on either method. Fapshi fronts both networks behind one hosted payment link;
# from your Fapshi dashboard (fapshi.com): apiuser + apikey.
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# "sandbox" for testing, "live" once ready for real payments.
FAPSHI_ENV="sandbox"
# Leave blank to use Fapshi's sandbox/live host automatically (picked from FAPSHI_ENV above).
FAPSHI_BASE_URL=""

# Admin notifications
# Admin notifications (new orders + payment confirmations via Resend)
ADMIN_EMAIL="admin@fondjoracine.com"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="care@fondjoracine.com"
# Required for live order alerts: set RESEND_API_KEY and a verified RESEND_FROM_EMAIL domain.
# ADMIN_EMAIL receives every new storefront order (placed + confirmed).

# Customer order-status SMS (Twilio) — optional; channel self-disables if unset.
# From the Twilio Console: Account SID + Auth Token (Account dashboard).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Preferred sender: a Messaging Service SID (handles geo-permissions/sender pool).
TWILIO_MESSAGING_SERVICE_SID=""
# Fallback sender if no Messaging Service: a single purchased Twilio number, E.164.
TWILIO_FROM_NUMBER=""

# Admin-only WhatsApp order alerts (Twilio Sandbox) — stopgap while the SMS
# compliance profile above is pending review. NOT for production: shared
# sandbox number, messages prefixed "Twilio Sandbox:", session expires ~24h
# after the admin last messaged the sandbox number from WhatsApp.
# whatsapp:+14155238886 is Twilio's standard sandbox number.
TWILIO_WHATSAPP_FROM=""
# Admin's own WhatsApp number, whatsapp:+237... — must have sent "join <code>"
# to TWILIO_WHATSAPP_FROM from this number first (console shows the current code).
TWILIO_WHATSAPP_TO=""

# Mobile money "Subscribe & save" renewal reminders (MTN MoMo / Orange Money
# have no stored-card auto-charge, so renewal is manual: a daily cron job
# texts a fresh Fapshi payment link once a month). Any long random string —
# generate with `openssl rand -hex 32`. Set the same value on the Vercel Cron
# job's Authorization header. Route: /api/cron/mobile-money-renewals.
CRON_SECRET=""

# Stripe — Card (Visa / Mastercard). Required for live card checkout.
STRIPE_SECRET_KEY=""
# Preferred: create a Price in Stripe Dashboard (100ml one-time) and paste the price_… id here.
# If empty, checkout falls back to inline USD pricing (XAF→USD, manual rate snapshot in
# one-product-order-service.ts — needs periodic updating, unlike a fixed-peg currency).
STRIPE_HAIR_ELIXIR_PRICE_ID=""
# Same as above, but for the 50ml bottle. Separate Price — never falls back to the
# 100ml price above. If empty, 50ml one-time checkout still works via inline USD
# pricing; this just gives it a real Dashboard Price for reporting/receipts.
STRIPE_HAIR_ELIXIR_PRICE_ID_50ML=""
# Optional: recurring monthly "subscribe & save" Price ID for the 100ml bottle.
# Leave blank to hide the subscribe option on the 100ml checkout.
STRIPE_HAIR_ELIXIR_SUBSCRIPTION_PRICE_ID=""
# Optional: recurring monthly "subscribe & save" Price ID for the 50ml bottle.
# Separate from the 100ml price above — leave blank to hide the subscribe option
# on the 50ml checkout (it will NOT fall back to the 100ml price).
STRIPE_HAIR_ELIXIR_SUBSCRIPTION_PRICE_ID_50ML=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PAYMENT_REQUEST_ENABLED="false"

# Cloudinary, optional for managed media uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Analytics & observability (optional — empty = disabled)
# ---------------------------------------------------------------------------
# Prefer GTM for GA4 + Meta + TikTok tags. Set Production values on Vercel only.
# Local: leave empty, or set NEXT_PUBLIC_ANALYTICS_DEBUG=true with GTM-… to test.
#
# 1. Google Tag Manager → create container for maisonfondjo.com → copy GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=""
# 2. Optional: GA4 measurement ID if you load gtag without GTM (prefer GTM instead)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# 3. Sentry (errors in production) — Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# Server-only DSN override (optional). Defaults to NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=""
# Set "true" only when testing GTM on localhost (never leave on in production)
NEXT_PUBLIC_ANALYTICS_DEBUG="false"
#
# Outside the repo also set up:
# - GA4 property linked in GTM (Configuration tag + key events: purchase, sign_up, generate_lead)
# - Meta Pixel / TikTok Pixel tags inside GTM (not hard-coded here)
# - Uptime monitor (UptimeRobot / Better Stack) on https://maisonfondjo.com
# - Vercel → Analytics + Speed Insights enabled for the project
# - Social links always with UTMs:
#   https://maisonfondjo.com/?utm_source=instagram&utm_medium=social&utm_campaign=bio
# ---------------------------------------------------------------------------
