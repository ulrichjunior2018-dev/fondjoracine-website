#!/usr/bin/env bash
# Pre-commit without lint-staged.
# lint-staged freezes on this Windows setup (prettier spin / "Applying modifications").
#
# Husky's runner always invokes this file as `sh -e <file>` (see .husky/_/h),
# ignoring the shebang above — so on any system where /bin/sh isn't bash
# (Debian/Ubuntu dash, most Linux dev boxes and CI images) the bash-only
# syntax below (arrays, process substitution) fails immediately with a
# syntax error and the hook never runs. Re-exec into real bash once, then
# continue as bash for the rest of this script.
#
# NOTE: checking `BASH_VERSION` alone is not enough — on macOS, /bin/sh is
# bash itself running in POSIX-compatibility mode (invoked with argv[0]
# "sh"). It still sets BASH_VERSION, so that check thinks it's "already
# bash" and skips the re-exec, but POSIX mode disables process substitution
# (`<(...)`), so the script still fails. Use our own marker instead so we
# always re-exec into a real, non-POSIX-mode bash exactly once.
if [ -z "${HUSKY_PRE_COMMIT_REEXEC:-}" ]; then
  HUSKY_PRE_COMMIT_REEXEC=1 exec bash "$0" "$@"
fi
set -e
cd "$(git rev-parse --show-toplevel)"

PRETTIER_FILES=()
ESLINT_FILES=()

while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  case "$f" in
    *.ts|*.tsx|*.mts|*.js|*.mjs|*.cjs)
      PRETTIER_FILES+=("$f")
      ESLINT_FILES+=("$f")
      ;;
    *.json|*.css|*.md)
      PRETTIER_FILES+=("$f")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ ${#PRETTIER_FILES[@]} -eq 0 ] && [ ${#ESLINT_FILES[@]} -eq 0 ]; then
  exit 0
fi

if [ ${#PRETTIER_FILES[@]} -gt 0 ]; then
  echo "pre-commit: prettier (${#PRETTIER_FILES[@]} files)..."
  npx prettier --write -- "${PRETTIER_FILES[@]}"
  git add -- "${PRETTIER_FILES[@]}"
fi

if [ ${#ESLINT_FILES[@]} -gt 0 ]; then
  echo "pre-commit: eslint (${#ESLINT_FILES[@]} files)..."
  npx eslint --fix -- "${ESLINT_FILES[@]}"
  git add -- "${ESLINT_FILES[@]}"
fi

echo "pre-commit: ok"
